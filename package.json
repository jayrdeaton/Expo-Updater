{
  "name": "@rific/updater",
  "version": "0.5.0",
  "description": "OTA update hook for Expo apps. Silent background fetch on foreground, manual check with confirmation dialog",
  "keywords": [
    "expo",
    "expo-updates",
    "ota",
    "react-native",
    "update"
  ],
  "homepage": "https://github.com/jayrdeaton/expo-updater#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/expo-updater/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/expo-updater.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "bin": {
    "rific-bump-ota": "./scripts/bump-ota-version.cjs",
    "rific-updater-build": "./scripts/build.cjs",
    "rific-updater-update": "./scripts/update.cjs"
  },
  "files": [
    "dist",
    "scripts",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.8",
    "@infinitetoken/jest-config": "^0.2.0",
    "@infinitetoken/tsconfig": "^0.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-updates": ">=0.25.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-native": "^0.85.3",
    "tsup": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo-updates": ">=57.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
